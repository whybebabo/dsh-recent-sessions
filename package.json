{
  "name": "@whybebabo/dsh-recent-sessions",
  "version": "0.1.4",
  "description": "Recent sessions across every workspace in one panel — plus a place to jot a thought now and have it come back when you reopen that conversation.",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whybebabo/dsh-recent-sessions.git"
  },
  "homepage": "https://github.com/whybebabo/dsh-recent-sessions#readme",
  "bugs": {
    "url": "https://github.com/whybebabo/dsh-recent-sessions/issues"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "assets/screenshot-1.jpg",
    "screenshots.json"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "react": ">=18.2.0 <19"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "recent-sessions",
    "sessions",
    "panel",
    "sidebar",
    "notes",
    "productivity"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
